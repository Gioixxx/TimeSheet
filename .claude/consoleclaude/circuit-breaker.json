{
  "maxBytes": 102400,
  "maxLines": 1500,
  "denyGlobs": [
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/*.map"
  ],
  "rtkRewrite": [],
  "riskGate": true,
  "protectedPaths": [],
  "lintConfigGate": true,
  "lintConfigFiles": [
    "eslint.config.*", ".eslintrc", ".eslintrc.*", ".eslintignore",
    "prettier.config.*", ".prettierrc", ".prettierrc.*", ".prettierignore",
    "stylelint.config.*", ".stylelintrc", ".stylelintrc.*", ".stylelintignore",
    ".markdownlint.*", ".markdownlint-cli2.*", ".markdownlintrc", ".markdownlintignore",
    "commitlint.config.*", ".commitlintrc", ".commitlintrc.*",
    ".oxlintrc.json", ".oxlintrc.jsonc", "oxlint.config.*"
  ],
  "lintConfigAllow": []
}
