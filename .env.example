# Copy to `.env` in the project root for local dev (Prisma CLI + Next.js load `.env`).
# Paths for SQLite are relative to the `prisma/` folder where `schema.prisma` lives.

DATABASE_URL="file:./timesheet.db"

# Optional — natural-language time entry parsing (Gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Login — abilita la maschera di accesso (da usare quando l'app è esposta su internet).
# Lasciare non impostato per l'uso desktop/Electron locale, dove non serve login.
# AUTH_ENABLED=true
# Chiave per firmare le sessioni di login. Se non impostata viene generata automaticamente
# e salvata in un file locale (.auth-secret) o su /data in Docker — nessuna azione richiesta.
# AUTH_SECRET=
